# ==============================================================================
# YAYASAN ISLAM AL KAHFI BATAM - SISTEM INFORMASI AKFIOKE
# KUNCI TOTAL AKSES HTTP LANGSUNG KE FOLDER STORAGE
# ==============================================================================
# Semua file di dalam storage/ (berkas upload, arsip backup database, log audit)
# TIDAK BOLEH diakses secara publik via URL statis browser.
# Akses hanya diperbolehkan melalui skrip controller internal PHP yang telah diautentikasi.
# ==============================================================================

# Apache 2.4+
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2 fallback
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

# Cegah eksekusi skrip apapun di dalam direktori penyimpanan
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
